#include <stdio.h>
#include <math.h>
int main() {
    float a, b, c;
    scanf("%f %f %f", &a, &b, &c);
    if (a == 0) {
        if (b == 0) {
            if (c == 0)
                printf("PT co vo so nghiem.");
            else
                printf("PT vo nghiem.");
        } else {
            printf("PT co 1 nghiem: x = %.2f", -c/b);
        }
    } else {
        float delta = b*b-4*a*c;
        if (delta < 0) {
            printf("PT vo nghiem.");
        } else if (delta == 0) {
            printf("PT co nghiem kep: x1 = x2 = %.2f", -b/(2*a));
        } else {
            float x1=(-b+sqrt(delta))/(2*a);
            float x2=(-b-sqrt(delta))/(2*a);
            printf("PT co 2 nghiem phan biet:\n");
            printf("x1 = %.2f\n", x1);
            printf("x2 = %.2f\n", x2);
        }
    }
    return 0;
}
