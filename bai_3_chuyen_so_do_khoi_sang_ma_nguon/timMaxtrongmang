#include <stdio.h>
int main() {
    int n;
    scanf("%d", &n);
    int a[n];
    printf("Nhap phan tu cua mang:\n");
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    int max = a[0];
    for (int i = 1; i < n; i++) {
        if (a[i] > max) {
            max = a[i];
        }
    }
    printf("So lon nhat trong mang là: %d\n", max);
}
